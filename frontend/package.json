{
  "name": "@tropio/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "generate:pages": "nuxt generate --envName pages",
    "start": "node .output/server/index.mjs",
    "lint": "nuxt prepare && eslint . --max-warnings 0",
    "typecheck": "nuxt typecheck",
    "test": "nuxt prepare && vitest run"
  },
  "dependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.4.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.14"
  }
}
