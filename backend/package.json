{
  "name": "@tropio/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/*-http.test.ts'"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-node": "12.5.1",
    "geographiclib-geodesic": "2.2.0",
    "geotiff": "3.0.5",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
